node_modules/
dist/
out/
.vscode-test/
*.vsix

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# deploy's version counter (see deploy) — keeps package.json out of git status.
.deploy-version

# stamped by ./deploy; claude3 warns before a prompt when files are newer
.deployed

# deploy's hashes of what it last built (the vsix) and installed (claude2-cap)
.deploy-hash
.deploy-cap-hash
