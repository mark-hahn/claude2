{
  "name": "claude2",
  "displayName": "Claude2",
  "description": "Claude Code VS Code extension rewrite with extra features",
  "version": "0.0.84",
  "publisher": "hahnca",
  "author": "Mark Hahn",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mark-hahn/claude2"
  },
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claude2",
          "title": "Claude2",
          "icon": "resources/claude2.svg"
        }
      ]
    },
    "views": {
      "claude2": [
        {
          "type": "webview",
          "id": "claude2.sidebar",
          "name": "Claude2"
        }
      ]
    },
    "commands": [
      {
        "command": "claude2.newSession",
        "title": "New Session",
        "category": "Claude2"
      },
      {
        "command": "claude2.simulateModelChange",
        "title": "Simulate Model Change",
        "category": "Claude2"
      },
      {
        "command": "claude2.openInstructions",
        "title": "Open Instructions",
        "category": "Claude2"
      },
      {
        "command": "claude2.openQuota",
        "title": "Open Quota",
        "category": "Claude2"
      }
    ],
    "configuration": {
      "title": "Claude2",
      "properties": {
        "claude2.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable the Claude2 extension."
        },
        "claude2.model": {
          "type": "string",
          "default": "claude-opus-5",
          "description": "Default Claude model for new Claude2 prompts."
        },
        "claude2.effort": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "default": "high",
          "description": "Default Claude effort level for new Claude2 prompts."
        },
        "claude2.contextWindowTokens": {
          "type": "number",
          "default": 256000,
          "description": "Context window token count shown in Claude2 conversations."
        },
        "claude2.maxTurns": {
          "type": "number",
          "default": 50,
          "description": "Maximum agentic turns per Claude2 prompt (passed to the Claude CLI as --max-turns)."
        },
        "claude2.maxBudgetUsd": {
          "type": "number",
          "default": 0,
          "description": "Maximum notional spend per Claude2 prompt in USD (--max-budget-usd). 0 means no limit."
        },
        "claude2.permissionMode": {
          "type": "string",
          "enum": [
            "acceptEdits",
            "auto",
            "bypassPermissions",
            "dontAsk",
            "plan"
          ],
          "default": "auto",
          "description": "Claude CLI permission mode used for Claude2 prompts."
        },
        "claude2.timezone": {
          "type": "string",
          "default": "America/Los_Angeles",
          "description": "IANA timezone used by the Claude quota pane."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "vsix": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.120.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.70.0"
  }
}
